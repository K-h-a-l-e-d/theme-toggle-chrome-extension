{
    "manifest_version": 3,
    "name": "Theme Toggle",
    "version": "1.1",
    "description": "Toggle between light and dark mode on any webpage.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_title": "Toggle Theme"
    }
}